# Used by hybrid mode (app on host). Docker Compose overrides this for containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flutr-db
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET / NEXTAUTH_URL are accepted as fallbacks for v4 compatibility.

# Shared read-only password for /:institution/guides, for staff without a Flutr
# account. Defaults to "flutr2026" when unset.
GUIDES_PASSWORD=

# Wingspan image microservice (butterfly photos).
# Without these the app runs, but every species renders a placeholder.
WINGSPAN_API_URL=http://159.203.134.226
WINGSPAN_API_KEY=
